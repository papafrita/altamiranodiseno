---
import { Image } from 'astro:assets';
import type { Product } from '~/data/catalog';
import { img } from '~/lib/img';

interface Props {
  product: Product;
  sizes?: string;
}

const { product, sizes = '(max-width: 640px) 72vw, (max-width: 1024px) 40vw, 24vw' } = Astro.props;
---

<a class="card" href={`/producto/${product.slug}`}>
  <div class:list={['card__media', { 'is-cutout': product.cutout }]}>
    <Image
      src={img(product.image)}
      alt={product.name}
      widths={[320, 480, 720]}
      sizes={sizes}
      class="card__img"
    />
  </div>
  <h3 class="card__title">{product.name}</h3>
  <p class="card__meta">{[...product.materials, product.dimensions].filter(Boolean).join(' · ')}</p>
</a>

<style>
  .card {
    display: block;
    text-align: center;
  }

  .card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--tile);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card__media.is-cutout .card__img {
    object-fit: contain;
    padding: 9% 12%;
  }

  .card:hover .card__img {
    transform: scale(1.04);
  }

  .card__title {
    margin-top: 12px;
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.35;
  }

  .card__meta {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
