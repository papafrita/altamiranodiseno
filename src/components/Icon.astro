---
interface Props {
  name: 'search' | 'menu' | 'close' | 'prev' | 'next' | 'instagram' | 'whatsapp' | 'mail' | 'plus';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m15.5 15.5 5 5" />
    </>
  )}
  {name === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'prev' && <path d="m15 4-8 8 8 8" />}
  {name === 'next' && <path d="m9 4 8 8-8 8" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4 20l1.2-4.1A8 8 0 1 1 8.3 19z" />
      <path d="M9.2 8.6c.2-.5.6-.5.9-.5h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5.6 1 1.4 1.8 2.4 2.3.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.5.7c.2.1.4.3.4.5 0 .6-.2 1.2-.7 1.5-.5.4-1.4.6-2.6.2-1.6-.5-3.2-1.9-4.1-3.3-.8-1.3-.9-2.4-.5-3.3z" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5.5" width="18" height="13" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
</svg>
