---
import { whatsappLink } from '~/data/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}

const {
  title = '¿Buscas algo a medida?',
  text = 'Fabricamos cada pieza en nuestro taller. Podemos adaptar medidas, maderas, terminaciones y colores de cuero a tu proyecto.',
  message = 'Hola, quisiera cotizar un mueble a medida.',
} = Astro.props;
---

<section class="band reveal">
  <div class="container band__inner">
    <h2 class="title-lg">{title}</h2>
    <p class="lead measure">{text}</p>
    <div class="band__actions">
      <a class="btn btn--solid" href={whatsappLink(message)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
      <a class="btn" href="/contacto">Contacto</a>
    </div>
  </div>
</section>

<style>
  .band {
    margin-top: var(--section);
    background: var(--bg-warm);
  }

  .band__inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding-block: clamp(56px, 7vw, 96px);
    text-align: center;
  }

  .band__inner p {
    margin: 0;
  }

  .band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 10px;
  }
</style>
