---
import { Image } from 'astro:assets';
import { img } from '~/lib/img';
import { url } from '~/lib/url';

interface Props {
  images: { image: string; caption?: string; href?: string }[];
}

const { images } = Astro.props;

const COLUMNS = 3;
const items = images.map((item) => {
  const meta = img(item.image);
  return { ...item, meta, tall: meta.height > meta.width * 1.1 };
});
// Tall images span two rows. Demote some of them (from the end) so the desktop grid ends without gaps.
let cells = items.reduce((n, i) => n + (i.tall ? 2 : 1), 0);
for (let i = items.length - 1; i >= 0 && cells % COLUMNS !== 0; i--) {
  if (items[i].tall) {
    items[i].tall = false;
    cells--;
  }
}
---

<ul class="gallery">
  {
    items.map(({ meta, tall, caption, href }) => {
      const Tag = href ? 'a' : 'div';
      return (
        <li class:list={['gallery__item reveal', { 'is-tall': tall }]}>
          <Tag class="gallery__inner" href={href && url(href)}>
            <Image src={meta} alt={caption ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
            {caption && <span class="gallery__caption">{caption}</span>}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(180px, 22vw, 340px);
    grid-auto-flow: dense;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item.is-tall {
    grid-row: span 2;
  }

  .gallery__inner {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--tile);
  }

  .gallery__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  a.gallery__inner:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery__caption {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #fff;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(160px, 34vw, 320px);
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
      grid-auto-rows: 70vw;
    }

    .gallery__item.is-tall {
      grid-row: span 1;
    }
  }
</style>
