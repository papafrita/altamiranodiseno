---
import '~/styles/global.css';
import { getImage } from 'astro:assets';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Search from '~/components/Search.astro';
import { site } from '~/data/site';
import { img } from '~/lib/img';
import { url } from '~/lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = 'ambientes/portada' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Muebles hechos a mano en Pucón`;
const ogImage = await getImage({ src: img(image), width: 1200, format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Search />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
        const track = rail.querySelector<HTMLElement>('.rail__track')!;
        const prev = rail.querySelector<HTMLButtonElement>('.rail__btn--prev');
        const next = rail.querySelector<HTMLButtonElement>('.rail__btn--next');
        const update = () => {
          const max = track.scrollWidth - track.clientWidth - 2;
          if (prev) prev.disabled = track.scrollLeft <= 2;
          if (next) next.disabled = track.scrollLeft >= max;
        };
        const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
        prev?.addEventListener('click', () => track.scrollBy({ left: -step() - 20, behavior: 'smooth' }));
        next?.addEventListener('click', () => track.scrollBy({ left: step() + 20, behavior: 'smooth' }));
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      });
    </script>
  </body>
</html>
